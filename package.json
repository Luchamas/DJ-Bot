{
  "name": "dj-bot",
  "version": "1.0.0",
  "description": "Bot de musica para Discord com suporte a links do YouTube e Spotify",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "deploy": "node src/deploy-commands.js",
    "smoke": "node scripts/smoke-test.mjs",
    "postinstall": "node scripts/install-ytdlp.mjs",
    "ytdlp:update": "node scripts/install-ytdlp.mjs --force"
  },
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "@noble/ciphers": "^2.1.1",
    "discord.js": "^14.27.0",
    "dotenv": "^17.4.2",
    "ffmpeg-static": "^5.3.0",
    "opusscript": "^0.1.1"
  },
  "optionalDependencies": {
    "@discordjs/opus": "^0.10.0"
  }
}
