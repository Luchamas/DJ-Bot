# ----- Discord (obrigatorio) -----
# Token do bot: https://discord.com/developers/applications -> Bot -> Reset Token
DISCORD_TOKEN=
# Application ID: mesma pagina -> General Information -> Application ID
DISCORD_CLIENT_ID=
# Opcional: ID do servidor para registrar os comandos instantaneamente (dev).
# Deixe vazio para registrar globalmente (leva ate 1h para aparecer).
DISCORD_GUILD_ID=

# ----- Spotify (opcional, mas recomendado) -----
# https://developer.spotify.com/dashboard -> Create app
# Sem isso, apenas links de faixa unica funcionam (via oEmbed) e albuns/playlists nao.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# ----- Ajustes -----
# Volume inicial (0-200)
DEFAULT_VOLUME=100
# Segundos sozinho no canal antes de sair (0 = nunca sai)
LEAVE_ON_EMPTY_SECONDS=120
# Segundos com a fila vazia antes de sair (0 = nunca sai)
LEAVE_ON_END_SECONDS=180
# Limite de faixas por fila
MAX_QUEUE_SIZE=500
# Limite de faixas importadas de uma playlist/album de uma vez
MAX_PLAYLIST_SIZE=200

# ----- Presence (status do bot) -----
# false desliga a presence com a faixa atual
PRESENCE_ENABLED=true
# De quantos em quantos segundos o tempo da musica e reescrito.
# O gateway do Discord aceita 5 atualizacoes a cada 20s: nao baixe de 5.
PRESENCE_UPDATE_SECONDS=15
# Texto exibido quando nao ha nada tocando
PRESENCE_IDLE_TEXT=/play

# ----- Teste (opcional) -----
# Playlist publica do Spotify usada por "npm run smoke". Playlists editoriais do
# proprio Spotify (IDs "37i9dQ...") sao bloqueadas pela API e nao servem aqui.
SMOKE_SPOTIFY_PLAYLIST=

# ----- yt-dlp (opcional) -----
# Segundos de tolerancia para o yt-dlp responder. O binario e um pacote
# PyInstaller que se descompacta a cada uso: num Raspberry Pi com cartao SD
# vale subir para 120 ou mais. O log de boot mostra o tempo de arranque.
YTDLP_TIMEOUT_SECONDS=60

# Caminho customizado para o binario (por padrao usa ./bin/yt-dlp[.exe] ou o do PATH)
YTDLP_PATH=
# Cookies para contornar "Sign in to confirm you're not a bot" do YouTube.
# Ou o caminho de um arquivo cookies.txt:
YTDLP_COOKIES=
# ...ou o nome do navegador (chrome, firefox, edge, brave, opera):
YTDLP_COOKIES_FROM_BROWSER=
